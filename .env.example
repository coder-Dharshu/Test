# Greencare AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Qwen 3.6 27B Vision Model Configuration ──────────────────────────────────
# Default high-accuracy vision model
QWEN_MODEL=qwen/qwen3.6-27b
QWEN_MAX_TOKENS=4096

# For cloud accelerated inference (e.g., Groq / OpenRouter / OpenAI-compatible endpoint):
QWEN_API_KEY=your_api_key_here

# For local offline inference (e.g., Ollama or vLLM), uncomment and set:
# LOCAL_MODEL_URL=http://localhost:11434/v1

# Backward-compatibility alias
GROQ_API_KEY=your_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Internal service URLs (used only when running without Docker) ──────────
LEGO2_URL=http://localhost:8001
LEGO3_URL=http://localhost:8002
GATEWAY_URL=http://localhost:8000

# ── Security ──────────────────────────────────────────────────────────────
# Change these in production! Used for JWT token signing.
SECRET_KEY=greencare-dev-secret-change-in-production
TOKEN_TTL_MINUTES=1440

# ── Webhook ───────────────────────────────────────────────────────────────
# Secret used to sign webhook payloads (HMAC-SHA256)
WEBHOOK_SECRET=greencare-webhook-secret-change-in-production

# ── Smart Triage Thresholds ───────────────────────────────────────────────
# Printable character ratio threshold for PDF fast-track (0.0–1.0)
PCS_THRESHOLD=0.50
# OCR confidence gate: below this → Qwen 3.6 27B fallback (0–100)
OCR_CONFIDENCE_THRESHOLD=80.0

# ── Auto-Cleanup (hours) ──────────────────────────────────────────────────
UPLOAD_CLEANUP_HOURS=24
LEGO2_TEMP_CLEANUP_HOURS=1
