# ==============================================================================
# Greencare AI / Pramaan IDP — Environment Variables Reference
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit your production .env file to version control.

# ── Inference Backend Configuration ──────────────────────────────────────────
# Options: groq | local | openai_compatible
INFERENCE_BACKEND=groq

# Privacy Guardrail:
# When set to false, prohibits any cloud VLM calls and flags degraded documents
# as 'needs_review' with reason 'cloud_disabled'.
ALLOW_CLOUD_ESCALATION=true

# Cloud Backend (Groq):
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b
QWEN_MODEL=qwen/qwen3.6-27b

# Local Backend (Ollama / vLLM):
LOCAL_MODEL_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=qwen3.6:27b
LOCAL_API_KEY=local-qwen

# Generic OpenAI-compatible endpoint (optional):
# OPENAI_COMPATIBLE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_api_key_here

# Inference Generation Parameters:
TEMPERATURE=0.0
MAX_TOKENS=4096
RESPONSE_FORMAT=json_object
VLM_HARD_TIMEOUT=60
VLM_MAX_RETRIES=3

# ── Microservice Port Configuration ───────────────────────────────────────────
PORT_GATEWAY=8000
PORT_TRIAGE=8001
PORT_QWEN=8002
PORT_HITL_GRADIO=7860
PORT_HITL_STREAMLIT=8501
PORT_ANALYTICS=8003

# Internal Service URLs:
LEGO2_URL=http://localhost:8001
LEGO3_URL=http://localhost:8002
GATEWAY_URL=http://localhost:8000
ANALYTICS_URL=http://localhost:8003

# ── Distributed Task Queue (Celery + Redis) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File Storage Directories ──────────────────────────────────────────────────
UPLOAD_DIR=./temp_uploads
PENDING_DIR=./pending_review
FINAL_DIR=./final_database
REJECTED_DIR=./rejected
LEGO2_TEMP=./lego2_temp
ASSETS_DIR=./extracted_assets
EXPORT_DIR=./exports
AUDIT_DIR=./audit

# ── Security & Authentication ─────────────────────────────────────────────────
SECRET_KEY=greencare-dev-secret-change-in-production
WEBHOOK_SECRET=greencare-webhook-secret-change-in-production
TOKEN_TTL_MINUTES=1440

# Optional API keys for securing internal dashboards (Lego 4 HITL / Lego 5 Analytics):
ANALYTICS_API_KEY=
HITL_ADMIN_PASSWORD=

# ── Ingestion & Document Processing Limits ───────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_PAGES_PER_DOC=100
MAX_BATCH_FILES=20
PER_FILE_TIMEOUT_SECONDS=120

# ── Smart Triage Thresholds ───────────────────────────────────────────────────
# Digital PDF printable character ratio (0.0 to 1.0)
PCS_THRESHOLD=0.50
# Local OCR confidence gate (0 to 100): < 80.0 escalates to VLM
OCR_CONFIDENCE_THRESHOLD=80.0

# ── Automated Storage Maintenance (Hours) ─────────────────────────────────────
UPLOAD_CLEANUP_HOURS=24
LEGO2_TEMP_CLEANUP_HOURS=1
