# Git ignore rules for Greencare AI / Pramaan IDP
.env
__pycache__/
*.py[cod]
*$py.class
venv/
.pytest_cache/
*.log

# Data directories (transient processing data)
temp_uploads/
pending_review/
final_database/
rejected/
lego2_temp/
extracted_assets/
exports/
audit/

# Temporary and state files
*.tmp
webhook_registry.json
idempotency_store.json

# Keep schemas and templates
!schemas/*.json
!.env.example
!docker-compose.yml
!requirements.txt
!.structure
